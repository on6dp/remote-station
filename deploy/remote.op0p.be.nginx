# /etc/nginx/sites-available/remote.op0p.be
# Remote Station — relais vers l'application Node (127.0.0.1:9000)
# Après installation : sudo certbot --nginx -d remote.op0p.be  (ajoute le bloc HTTPS 443)

map $http_upgrade $rs_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name remote.op0p.be;

    # Journal séparé pour ce site
    access_log /var/log/nginx/remote.op0p.be.access.log;
    error_log  /var/log/nginx/remote.op0p.be.error.log;

    location /ws {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $rs_connection_upgrade;
        proxy_set_header Host $host;
        # On écrase (pas d'ajout) : le client ne peut pas falsifier son IP dans le journal
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
